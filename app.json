{
  "expo": {
    "name": "artemis-creatives-tracker",
    "slug": "artemis-creatives-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/artemis-creatives-tracker.png",
    "scheme": "artemiscreativestracker",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo/android-adaptive-foreground.png",
        "backgroundColor": "#03080B"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.neilpatrick.artemiscreativestracker",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/artemis-creatives-tracker.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#047857",
          "image": "./assets/images/logo/artemis-logo.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#047857"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo/notification-icon.png",
          "color": "#047857",
          "defaultChannel": "reviews"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone to record voice reviews."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe376c36-75e3-49ba-aa08-64c524c1bcdc"
      }
    }
  }
}
